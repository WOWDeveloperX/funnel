# Copy to .env for local overrides: `cp .env.example .env`.
# Read by `npm run dev`, `npm start`, `npm run generate` and `npm run publish-config`
# via Node's --env-file-if-exists (variables already set in the shell win).
# On Railway set the same names in the service Variables; .env is never committed or baked into the image.

# --- server -------------------------------------------------------------------------------------
# HTTP port. In `npm run dev` the API port is taken from API_PORT below instead.
PORT=3000
# Bind address (0.0.0.0 inside containers).
HOST=0.0.0.0
# SQLite file; the directory is created on boot. In Docker it is /data/funnel.db (a mounted volume).
DATABASE_PATH=./data/funnel.db
# Admin token, sent in the x-admin-token header; guards admin writes and the session/event lists.
# Empty = admin is open (local only). Required in production.
ADMIN_TOKEN=
# Config published and activated on the first boot of an empty database.
SEED_CONFIG=configs/funnel-v1.json
# Content translation catalogs (<funnelId>.<lang>.json), loaded and validated on boot; a bad file
# stops the server. A missing directory means the funnel is shown in its source language only.
TRANSLATIONS_DIR=configs/translations
# Built SPA served by the API (`npm run build`); ignored when the directory is missing.
WEB_DIST=apps/web/dist
# Fastify/pino log level: fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info

# --- dev only -----------------------------------------------------------------------------------
# API port for `npm run dev` and the Vite proxy target. Evaluated by the shell before .env is read,
# so set it on the command line: `API_PORT=3100 npm run dev`.
# API_PORT=3000

# --- CLI scripts (generate, publish-config) -----------------------------------------------------
# Base URL of a running server; ADMIN_TOKEN above is reused for authenticated calls.
FUNNEL_URL=http://localhost:3000
